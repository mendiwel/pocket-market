# Leave empty to run in local-only mode (LocalStorageRepository).
# Fill these in (Firebase console → Project settings → Web app) to enable
# Google Sign-In + Firestore multi-family mode.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional: Gemini API key for warm AI Hebrew TTS ('gemini-3.8-flash-lite-tts').
# Protected by a strict client-side daily & per-minute quota guard + IndexedDB audio cache.
# Can also be entered directly in Parent Portal -> Settings.
VITE_GEMINI_API_KEY=
