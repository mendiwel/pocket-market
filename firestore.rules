rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each family document is owned by the parent's Google account.
    // familyId === the parent's Firebase Auth uid.
    match /families/{familyId} {
      allow read, delete: if request.auth != null && request.auth.uid == familyId;
      allow create, update: if request.auth != null
        && request.auth.uid == familyId
        && request.resource.data.ownerUid == familyId
        && request.resource.data.familyId == familyId
        && request.resource.data.children.size() <= 20;
    }

    // Feedback is write-only for signed-in parents; triage happens in the console.
    match /feedback/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.familyId == request.auth.uid
        && request.resource.data.type in ['bug', 'improvement', 'difficulty', 'other']
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 2000
        && request.resource.data.keys().hasOnly(['id', 'familyId', 'type', 'message', 'createdAt', 'clientCreatedAt', 'metadata']);
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
